# Copy to .env and fill in local values.

# AI_API_KEY=
# MAPS_API_KEY=
# WEATHER_API_KEY=
# DATABASE_URL=

# Hotel provider остается FAKE, пока REAL не выбран явно.
# HOTEL_PROVIDER_MODE=FAKE
# HOTELS_API_PUBLIC_BASE_URL=https://hotels.tbank.ru/
# HOTELS_API_PUBLIC_TIMEOUT_MS=60000
# HOTELS_API_USER_LANGUAGE=RU

# Отдельный browser-independent MCP для Hotels API. Service JWT key хранится
# вне репозитория; строка ниже загружает PEM в окружение локального процесса.
# TBANK_HOTELS_API_BASE_URL=https://<approved-qa-hotels-api-origin>/
# TBANK_HOTELS_JWT_ISSUER=HOTELSSEARCHAPI
# TBANK_HOTELS_JWT_AUDIENCE=HOTELSAPI
# TBANK_HOTELS_JWT_PRIVATE_KEY="$(< /absolute/path/to/hotels-qa-rsa-key.pem)"
# TBANK_HOTELS_JWT_AUTH_PREFIX=Bearer
# OpenAPI требует x-real-ip для booking/LS create. Не подставляйте произвольный
# IP и не передавайте его модели: источник должен подтвердить владелец API или
# доверенный gateway. Service JWT сам по себе booking execution не активирует.
# Реальные booking/payment/cancel вызовы по умолчанию заблокированы MCP.
# Включать только для утверждённого non-production сценария после проверки auth.
# TBANK_HOTELS_ENABLE_MUTATIONS=false

# LLM provider остается FAKE, пока OPENROUTER не выбран явно.
# OPENROUTER_MODEL ниже является примером для локального QA, а не default в коде.
# LLM_PROVIDER_MODE=FAKE
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_MS=30000
# OPENROUTER_RUNTIME_QA_ENABLED=false

# Semantic accommodation analysis остаётся deterministic FAKE по умолчанию.
# OPENROUTER запрещён до отдельного approval provider content, model/ZDR probe
# и прохождения quality evaluation.
# ACCOMMODATION_ANALYSIS_MODE=FAKE
# ACCOMMODATION_ANALYSIS_EXTERNAL_CONTENT_APPROVED=false
# ACCOMMODATION_ANALYSIS_MODEL=
# ACCOMMODATION_ANALYSIS_PROVIDER_ENDPOINT=
# ACCOMMODATION_ANALYSIS_BASE_URL=https://openrouter.ai/api/v1/
# ACCOMMODATION_ANALYSIS_TIMEOUT_MS=15000
# ACCOMMODATION_ANALYSIS_BATCH_SIZE=5
# ACCOMMODATION_ANALYSIS_IMAGE_HOSTS=

# Корпоративный gateway использует тот же application contract, но отдельный
# versioned HTTP endpoint и opaque deployment ID. По умолчанию не активирован.
# ACCOMMODATION_ANALYSIS_INTERNAL_CONTENT_APPROVED=false
# ACCOMMODATION_ANALYSIS_INTERNAL_GATEWAY_URL=
# ACCOMMODATION_ANALYSIS_DEPLOYMENT_ID=
# ACCOMMODATION_ANALYSIS_INTERNAL_GATEWAY_TOKEN=

# Локальный demo launcher: node scripts/local-demo.mjs --fake|--real
# JAVA_HOME настраивается в shell или здесь локальным путем к Java 17.
# HOST=127.0.0.1
# PORT=8080
# DEMO_BACKEND_PORT=8080
# DEMO_FRONTEND_PORT=4173
# DEMO_STARTUP_TIMEOUT_MS=120000
